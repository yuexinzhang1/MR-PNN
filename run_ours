import os
import random
import pickle
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from scipy import stats

from models_mrpnn import PNN
from my_utils2 import CustomDataset, evaluate_model_with_metrics

SEEDS = [42, 123, 456, 789, 2026]

TASK_FILES = [
    "CN-AD.csv",
    "MCI-AD.csv",
    "CN-MCI.csv",
]
TASK_NAMES = ["CN-AD (Task 0)", "MCI-AD (Task 1)", "CN-MCI (Task 2)"]


def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)
        torch.backends.cudnn.deterministic = True
        torch.backends.cudnn.benchmark = False


# ==============================================================
# 5 个 Seed 独立循环执行主体
# ==============================================================

ours_results = {
    t: {"acc": [], "sen": [], "spe": [], "auc": [], "pre": [], "f1": []}
    for t in range(len(TASK_FILES))
}

print("\n" + "=" * 70)
print("🚀 开始测试核心模型: Ours (MR-PNN)")
print("=" * 70)

for seed_idx, seed in enumerate(SEEDS):
    print(f"\n---> [Model: Ours] 正在执行 Seed [{seed_idx + 1}/5] (Random Seed = {seed})")
    set_seed(seed)

    train_loaders = []
    test_loaders = []

    # 1. 数据隔离划分与标准化，严防测试集泄露
    for task_id, task_file in enumerate(TASK_FILES):
        data = pd.read_csv(task_file)
        data.replace('<missing>', pd.NA, inplace=True)
        data.dropna(inplace=True)

        train_data, test_data = train_test_split(
            data, test_size=0.2, random_state=seed, stratify=data.iloc[:, -1]
        )

        train_data = train_data.copy()
        test_data = test_data.copy()

        scaler = StandardScaler()
        columns_to_scale = data.columns[3:-2]
        train_data[columns_to_scale] = scaler.fit_transform(train_data[columns_to_scale])
        test_data[columns_to_scale] = scaler.transform(test_data[columns_to_scale])

        train_loader = DataLoader(CustomDataset(train_data), batch_size=64, shuffle=True, drop_last=True)
        test_loader = DataLoader(CustomDataset(test_data), batch_size=64, shuffle=False)

        train_loaders.append(train_loader)
        test_loaders.append(test_loader)

    # 2. 初始化持续学习网络架构
    model = PNN(n_layers=3)

    # 3. 顺序学习三项诊断任务 (CN-AD -> MCI-AD -> CN-MCI)
    for task_id in range(len(TASK_FILES)):
        train_loader = train_loaders[task_id]

        # 动态添加当前任务列，内部自动冻结所有前序列并初始化横向 Adapter
        model.new_task(
            mlp_input_dim=8, mlp_hidden_dim=16, mlp_output_dim=4,
            moe_input_dim=8, moe_hidden_dim=16, moe_output_dim=4,
            classifier_input_dim=4,
            num_experts=4
        )

        criterion = nn.CrossEntropyLoss()
        optimizer = optim.AdamW(
            filter(lambda p: p.requires_grad, model.parameters()),
            lr=0.001,
            weight_decay=1e-4
        )

        for epoch in range(200):
            model.train()
            for features, genomic, labels, brain, ref in train_loader:
                optimizer.zero_grad()

                modalities = {
                    'x_path': features,
                    'x_omic': genomic,
                    'x_brain': brain,
                    'ref': ref,
                    'x_label': labels
                }

                logits = model(modalities, task_id=task_id)

                if labels.dim() > 1 and labels.shape[-1] > 1:
                    targets = labels.argmax(dim=-1).long()
                else:
                    targets = labels.squeeze().long()

                loss = criterion(logits, targets)
                loss.backward()

                nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
                optimizer.step()

        # 评估当前任务
        model.eval()
        acc, sen, spe, auc_score, pre, f1 = evaluate_model_with_metrics(
            model, test_loaders[task_id], task_id
        )
        ours_results[task_id]["acc"].append(acc * 100.0)
        ours_results[task_id]["auc"].append(auc_score)
        ours_results[task_id]["sen"].append(sen * 100.0)
        ours_results[task_id]["spe"].append(spe * 100.0)
        ours_results[task_id]["pre"].append(pre * 100.0)
        ours_results[task_id]["f1"].append(f1 * 100.0)

# ==============================================================
# 5 个 Seed 阶段性统计与最终总表输出
# ==============================================================

print("\n" + "=" * 135)
print("📊 Ours (MR-PNN) 5 次独立种子完整评测统计总表 (Mean ± SD [95% CI])")
print("=" * 135)

for t_idx, t_name in enumerate(TASK_NAMES):
    print(f"\n▶ 任务: {t_name}")
    print(f"{'Metric':<12} | {'Mean ± SD':<25} | {'95% CI':<25}")
    print("-" * 65)

    for metric in ["acc", "auc", "sen", "spe", "pre", "f1"]:
        vals = ours_results[t_idx][metric]
        mean_val = np.mean(vals)
        std_val = np.std(vals, ddof=1)
        ci_val = stats.t.interval(0.95, df=len(vals) - 1, loc=mean_val, scale=stats.sem(vals))

        if metric == "auc":
            mean_std_str = f"{mean_val:.4f} ± {std_val:.4f}"
            ci_str = f"[{ci_val[0]:.4f}, {ci_val[1]:.4f}]"
        else:
            mean_std_str = f"{mean_val:.2f} ± {std_val:.2f}%"
            ci_str = f"[{ci_val[0]:.2f}%, {ci_val[1]:.2f}%]"

        print(f"{metric.upper():<12} | {mean_std_str:<25} | {ci_str:<25}")

save_filename = "ours_mrpnn_5seeds_results.pkl"
with open(save_filename, "wb") as f:
    pickle.dump(ours_results, f)
print(f"\n✅ Ours 完整评测指标已保存至: {save_filename}")
