        train_loaders = []
        test_loaders = []

        for task_id, task_file in enumerate(TASK_FILES):
            data = pd.read_csv(task_file)
            data.replace('<missing>', pd.NA, inplace=True)
            data.dropna(inplace=True)

            train_data, test_data = train_test_split(
                data, test_size=0.2, random_state=seed, stratify=data.iloc[:, -1]
            )

            train_data = train_data.copy()
            test_data = test_data.copy()

            scaler = StandardScaler()
            columns_to_scale = data.columns[3:-2]
            train_data[columns_to_scale] = scaler.fit_transform(train_data[columns_to_scale])
            test_data[columns_to_scale] = scaler.transform(test_data[columns_to_scale])

            train_loader = DataLoader(CustomDataset(train_data), batch_size=32, shuffle=True, drop_last=True)
            test_loader = DataLoader(CustomDataset(test_data), batch_size=32, shuffle=False)

            train_loaders.append(train_loader)
            test_loaders.append(test_loader)

        if model_name == "Ours":
            pnn_model = PNN(n_layers=3)

        for task_id in range(len(TASK_FILES)):
            train_loader = train_loaders[task_id]

            if model_name == "Ours":
                model = pnn_model
                model.new_task(
                    mlp_input_dim=8, mlp_hidden_dim=16, mlp_output_dim=4,
                    moe_input_dim=8, moe_hidden_dim=16, moe_output_dim=4,
                    classifier_input_dim=4, num_experts=4
                )
            else:
                model = ModalityAblationModel(ablation_type=model_name, pca_components=32)

                if model_name == "Unsupervised Selection (PCA)":
                    train_full_x = []
                    for f, g, _, _, _ in train_loader:
                        xb = f.flatten(1).float()
                        xo = g.flatten(1).float()
                        train_full_x.append(torch.cat([xb, xo], dim=-1))
                    train_full_x = torch.cat(train_full_x, dim=0).numpy()
                    pca = PCA(n_components=32, random_state=seed)
                    pca.fit(train_full_x)
                    model.pca_proj = torch.tensor(pca.components_.T, dtype=torch.float32)

            if model_name == "Concatenation (all modalities)":
                for init_f, init_g, _, init_b, init_r in train_loader:
                    dummy_mod = {
                        'x_path': init_f,
                        'x_omic': init_g,
                        'ref': init_r,
                        'x_label': torch.zeros(init_f.size(0))
                    }
                    _ = model(dummy_mod, task_id=task_id)
                    break

            criterion = nn.CrossEntropyLoss()
            optimizer = optim.AdamW(
                filter(lambda p: p.requires_grad, model.parameters()),
                lr=0.001,
                weight_decay=1e-3
            )

            for epoch in range(200):
                model.train()
                for features, genomic, labels, brain, ref in train_loader:
                    optimizer.zero_grad()

                    modalities = {
                        'x_path': features,
                        'x_omic': genomic,
                        'ref': ref,
                        'x_label': labels
                    }

                    logits = model(modalities, task_id=task_id)

                    if labels.dim() > 1 and labels.shape[-1] > 1:
                        targets = labels.argmax(dim=-1).long()
                    else:
                        targets = labels.squeeze().long()

                    loss = criterion(logits, targets)
                    loss.backward()

                    nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
                    optimizer.step()

            model.eval()
            acc, sen, spe, auc_score, pre, f1 = evaluate_model_with_metrics(
                model, test_loaders[task_id], task_id
            )
            metrics_results[model_name][task_id]["acc"].append(acc * 100.0)
            metrics_results[model_name][task_id]["auc"].append(auc_score)
            metrics_results[model_name][task_id]["sen"].append(sen * 100.0)
            metrics_results[model_name][task_id]["spe"].append(spe * 100.0)

