def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)
        torch.backends.cudnn.deterministic = True
        torch.backends.cudnn.benchmark = False


class RobustMLP(nn.Module):

    def __init__(self, in_dim=None, hidden_dim=32, num_classes=2, dropout_rate=0.2):
        super().__init__()
        linear_layer = nn.Linear(in_dim, hidden_dim) if in_dim is not None else nn.LazyLinear(hidden_dim)
        self.net = nn.Sequential(
            linear_layer,
            nn.LayerNorm(hidden_dim),
            nn.ReLU(),
            nn.Dropout(dropout_rate),
            nn.Linear(hidden_dim, 16),
            nn.LayerNorm(16),
            nn.ReLU(),
            nn.Dropout(dropout_rate),
            nn.Linear(16, num_classes)
        )

    def forward(self, x):
        return self.net(x)


class AttentionFusionBlock(nn.Module):

    def __init__(self, brain_dim=204, omic_dim=144, embed_dim=32, num_classes=2):
        super().__init__()
        self.proj_b = nn.Sequential(nn.Linear(brain_dim, embed_dim), nn.LayerNorm(embed_dim), nn.ReLU())
        self.proj_o = nn.Sequential(nn.Linear(omic_dim, embed_dim), nn.LayerNorm(embed_dim), nn.ReLU())
        self.attn = nn.MultiheadAttention(embed_dim=embed_dim, num_heads=2, batch_first=True)
        self.norm = nn.LayerNorm(embed_dim)
        self.classifier = nn.Sequential(
            nn.Linear(embed_dim * 2, 16),
            nn.ReLU(),
            nn.Dropout(0.2),
            nn.Linear(16, num_classes)
        )

    def forward(self, x_brain, x_omic):
        tb = self.proj_b(x_brain).unsqueeze(1)
        to = self.proj_o(x_omic).unsqueeze(1)
        tokens = torch.cat([tb, to], dim=1)  # [B, 2, embed_dim]
        attn_out, _ = self.attn(tokens, tokens, tokens)
        tokens = self.norm(tokens + attn_out)  
        flat_feats = tokens.reshape(tokens.size(0), -1)
        return self.classifier(flat_feats)


class ModalityAblationModel(nn.Module):
    def __init__(self, ablation_type, pca_components=32):
        super().__init__()
        self.ablation_type = ablation_type
        self.pca_proj = None

        if ablation_type == "sMRI":
            self.net = RobustMLP(in_dim=204, hidden_dim=32)
        elif ablation_type == "Genetics":
            self.net = RobustMLP(in_dim=11, hidden_dim=16)
        elif ablation_type == "Phenotypic":
            self.net = RobustMLP(in_dim=2, hidden_dim=8)
        elif ablation_type == "PRS":
            self.net = RobustMLP(in_dim=24, hidden_dim=16)
        elif ablation_type == "Concatenation (sMRI + Phenotypic)":
            self.net = RobustMLP(in_dim=204 + 2, hidden_dim=32)
        elif ablation_type == "Concatenation (all modalities)":
            self.net = RobustMLP(in_dim=None, hidden_dim=64, dropout_rate=0.3)
        elif ablation_type == "Unsupervised Selection (PCA)":
            self.net = RobustMLP(in_dim=pca_components, hidden_dim=16)
        elif ablation_type == "Attention-based Fusion (all modalities)":
            self.net = AttentionFusionBlock(brain_dim=204, omic_dim=144, embed_dim=32)

    def forward(self, modalities, task_id=None):
        x_brain = modalities['x_path'].flatten(start_dim=1).float()

        raw_omic = modalities['x_omic'].float()
        x_omic_flat = raw_omic.flatten(start_dim=1)

        ref = modalities['ref'].float()

        if self.ablation_type == "sMRI":
            return self.net(x_brain)

        elif self.ablation_type == "Genetics":
            real_snps = ref[:, 64:75] if ref.shape[1] >= 75 else ref[:, -11:]
            return self.net(real_snps)

        elif self.ablation_type == "Phenotypic":
            real_phenotypic = raw_omic[:, 0, 2:4]
            return self.net(real_phenotypic)

        elif self.ablation_type == "PRS":
            real_prs = raw_omic[:, :, 0]
            return self.net(real_prs)

        elif self.ablation_type == "Concatenation (sMRI + Phenotypic)":
            real_phenotypic = raw_omic[:, 0, 2:4]
            x = torch.cat([x_brain, real_phenotypic], dim=-1)
            return self.net(x)

        elif self.ablation_type == "Concatenation (all modalities)":
            full_x = torch.cat([x_brain, x_omic_flat], dim=-1)
            return self.net(full_x)

        elif self.ablation_type == "Unsupervised Selection (PCA)":
            full_x = torch.cat([x_brain, x_omic_flat], dim=-1)
            x_reduced = torch.matmul(full_x, self.pca_proj.to(full_x.device))
            return self.net(x_reduced)

        elif self.ablation_type == "Attention-based Fusion (all modalities)":
            return self.net(x_brain, x_omic_flat)


