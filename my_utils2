import torch
import torch.nn as nn
import math
import torch.nn.functional as F
from torch.utils.data import Dataset
import pandas as pd
import numpy as np
import pickle
from sklearn.metrics import accuracy_score, confusion_matrix, roc_curve, auc, precision_score, f1_score


class MultiHeadAttentionQ(nn.Module):
    def __init__(self, in_features, head_num, bias=True, activation=F.relu):
        super(MultiHeadAttentionQ, self).__init__()
        if in_features % head_num != 0:
            raise ValueError(f'`in_features`({in_features}) should be divisible by `head_num`({head_num})')
        self.in_features = in_features
        self.head_num = head_num
        self.activation = activation
        self.bias = bias
        self.fc_concat = nn.Linear(48, 16)
        self.conv1 = nn.Conv1d(in_channels=16, out_channels=16, kernel_size=3, padding=1)
        self.conv2 = nn.Conv1d(in_channels=16, out_channels=16, kernel_size=5, padding=2)
        self.conv3 = nn.Conv1d(in_channels=16, out_channels=16, kernel_size=7, padding=3)

        self.linear_q = nn.Linear(in_features, in_features, bias)
        self.linear_k = nn.Linear(in_features, in_features, bias)
        self.linear_v = nn.Linear(in_features, in_features, bias)
        self.linear_o = nn.Linear(in_features, in_features, bias)

    def forward(self, q, k, v, mask=None):
        q = q.permute(0, 2, 1)
        q1 = self.conv1(q)
        q2 = self.conv2(q)
        q3 = self.conv3(q)

        q1 = q1.permute(0, 2, 1)
        q2 = q2.permute(0, 2, 1)
        q3 = q3.permute(0, 2, 1)

        q1 = self.linear_q(q1)
        q2 = self.linear_q(q2)
        q3 = self.linear_q(q3)
        k = self.linear_k(k)
        v = self.linear_v(v)

        if self.activation is not None:
            q1 = self.activation(q1)
            q2 = self.activation(q2)
            q3 = self.activation(q3)
            k = self.activation(k)
            v = self.activation(v)

        q1 = self._reshape_to_batches(q1)
        q2 = self._reshape_to_batches(q2)
        q3 = self._reshape_to_batches(q3)
        k = self._reshape_to_batches(k)
        v = self._reshape_to_batches(v)

        if mask is not None:
            mask = mask.repeat(self.head_num, 1, 1)

        y1, scores1 = ScaledDotProductAttention2()(q1, k, v, mask)
        y2, scores2 = ScaledDotProductAttention2()(q2, k, v, mask)
        y3, scores3 = ScaledDotProductAttention2()(q3, k, v, mask)

        y1 = self._reshape_from_batches(y1)
        y2 = self._reshape_from_batches(y2)
        y3 = self._reshape_from_batches(y3)

        y = torch.cat((y1, y2, y3), dim=2)
        output = self.fc_concat(y)

        y = self.linear_o(output)
        if self.activation is not None:
            y = self.activation(y)

        return y, (scores1, scores2, scores3)

    def _reshape_to_batches(self, x):
        batch_size, seq_len, in_feature = x.size()
        sub_dim = in_feature // self.head_num
        return x.reshape(batch_size, seq_len, self.head_num, sub_dim) \
            .permute(0, 2, 1, 3) \
            .reshape(batch_size * self.head_num, seq_len, sub_dim)

    def _reshape_from_batches(self, x):
        batch_size, seq_len, in_feature = x.size()
        batch_size //= self.head_num
        out_dim = in_feature * self.head_num
        return x.reshape(batch_size, self.head_num, seq_len, in_feature) \
            .permute(0, 2, 1, 3) \
            .reshape(batch_size, seq_len, out_dim)


class ScaledDotProductAttention2(nn.Module):
    def forward(self, query, key, value, mask=None):
        dk = query.size()[-1]
        scores = query.matmul(key.transpose(-2, -1)) / math.sqrt(dk)
        if mask is not None:
            scores = scores.masked_fill(mask == 0, -1e9)
        attention = F.softmax(scores, dim=-1)
        return attention.matmul(value), scores


class CustomDataset(Dataset):
    def __init__(self, data):
        self.data = data.copy()
        self.data.replace('<missing>', pd.NA, inplace=True)
        self.data.dropna(inplace=True)

        self.labels = self.data.iloc[:, 1:3].values
        self.brain = self.data.iloc[:, 3:44].values
        self.ref = self.data.iloc[:, 296:-2].values

        reshaped_data_brain = np.empty((self.data.shape[0], 34, 6))

        for i in range(self.data.shape[0]):
            sample_features = self.data.iloc[i, 44:248]
            for j in range(34):
                for k in range(6):
                    feature_idx = k * 34 + j
                    # 修复 FutureWarning: 使用 iloc 替代原生角标
                    reshaped_data_brain[i, j, k] = sample_features.iloc[feature_idx]

        self.features = reshaped_data_brain

        reshaped_data_gene = np.empty((self.data.shape[0], 24, 2))
        for n in range(self.data.shape[0]):
            sample_feature = self.data.iloc[n, 248:272].values
            reshaped_data_gene[n, :, 0] = sample_feature

        for n in range(self.data.shape[0]):
            sample_feature = self.data.iloc[n, 272:296].values
            reshaped_data_gene[n, :, 1] = sample_feature

        additional_features = self.data.iloc[:, -2:].values
        additional_features[:, 0] = np.where(additional_features[:, 0] > 70, 70, additional_features[:, 0])
        additional_features_reshaped = np.repeat(additional_features[:, np.newaxis, :], 24, axis=1)
        reshaped_data_gene = np.concatenate((reshaped_data_gene, additional_features_reshaped), axis=2)

        data_ukb = pd.read_csv(r"G:\MyData\ProgressiveNeuralNetworks.pytorch-master\24脑区+age+sex.csv")
        new_genomic_data = np.zeros((self.data.shape[0], 24, 6))
        new_genomic_data[:, :, :4] = reshaped_data_gene
        for i in range(self.data.shape[0]):
            age = np.round(reshaped_data_gene[i, 0, 2])
            sex = np.round(reshaped_data_gene[i, 0, 3])

            filtered_data = data_ukb[(data_ukb.iloc[:, 25].round() == age) & (data_ukb.iloc[:, 26].round() == sex)]

            if not filtered_data.empty:
                brain_region_means = filtered_data.iloc[:, 1:25].mean()
                brain_region_stds = filtered_data.iloc[:, 1:25].std()
                new_genomic_data[i, :, 4] = brain_region_means
                new_genomic_data[i, :, 5] = brain_region_stds
            else:
                new_genomic_data[i, :, 4] = np.nan
                new_genomic_data[i, :, 5] = np.nan

        self.genomic_data = new_genomic_data

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        features = torch.FloatTensor(self.features[idx])
        genomic = torch.FloatTensor(self.genomic_data[idx])
        label = torch.tensor(self.labels[idx], dtype=torch.long)
        brain = torch.FloatTensor(self.brain[idx])
        ref = torch.FloatTensor(self.ref[idx])
        return features, genomic, label, brain, ref


def evaluate_model_with_metrics(model, test_loader, task_id):
    """
    通用、鲁棒的多指标测试函数
    彻底移除 batch_size < 64 的跳过逻辑，确保所有测试集样本全量参与评测
    """
    model.eval()
    all_true = []
    all_pred = []
    all_probs = []

    with torch.no_grad():
        for features, genomic, labels, brain, ref in test_loader:
            # ✅ 移除跳过限制！测试集任何尺寸的 batch 都要计算

            modalities = {
                'x_path': features,
                'x_omic': genomic,
                'x_brain': brain,
                'x_label': labels,
                'ref': ref
            }

            logits = model(modalities, task_id=task_id)

            # 兼容模型直接返回 Logits 或 Sigmoid 概率
            if logits.size(1) == 2:  # [B, 2] 二分类 Logits
                probs = torch.softmax(logits, dim=1)
                preds = torch.argmax(probs, dim=1)
                prob_positive = probs[:, 1].cpu().numpy()
            else:  # [B, 1] 单通道输出
                prob_positive = torch.sigmoid(logits).squeeze().cpu().numpy()
                preds = (torch.sigmoid(logits).squeeze() > 0.5).int()

            # 兼容 One-Hot 标签与单值标签
            if labels.dim() > 1 and labels.size(1) > 1:
                true_labels_single = labels.argmax(dim=1).cpu().numpy()
            else:
                true_labels_single = labels.cpu().numpy().astype(int)

            pred_labels_single = preds.cpu().numpy().astype(int)

            all_true.extend(true_labels_single.tolist())
            all_pred.extend(pred_labels_single.tolist())
            all_probs.extend(prob_positive.tolist())

    all_true = np.array(all_true)
    all_pred = np.array(all_pred)
    all_probs = np.array(all_probs)

    # 1. ACC
    acc = accuracy_score(all_true, all_pred)

    # 2. 混淆矩阵 (固定类别 labels=[0, 1]，防止极端情况下类别缺失无法解包)
    try:
        tn, fp, fn, tp = confusion_matrix(all_true, all_pred, labels=[0, 1]).ravel()
        sensitivity = tp / (tp + fn) if (tp + fn) > 0 else 0.0
        specificity = tn / (tn + fp) if (tn + fp) > 0 else 0.0
        precision = precision_score(all_true, all_pred, zero_division=0)
        f1_score_val = f1_score(all_true, all_pred, zero_division=0)
    except Exception as e:
        print(f"⚠️  Confusion matrix 计算异常: {e}")
        sensitivity = specificity = precision = f1_score_val = float('nan')

    # 3. AUC
    try:
        fpr, tpr, _ = roc_curve(all_true, all_probs)
        auc_score = auc(fpr, tpr)
    except Exception as e:
        print(f"⚠️  ROC/AUC 计算异常: {e}")
        auc_score = 0.5

    return acc, sensitivity, specificity, auc_score, precision, f1_score_val
